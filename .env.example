# PostgreSQL
POSTGRES_DB=histra
POSTGRES_USER=histra
POSTGRES_PASSWORD=change-this-password

# API
API_PORT=8000
STORAGE_ROOT=/data
LEASE_SECONDS=300
LEASE_REAPER_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
SQL_ECHO=false

# Local build by default. On the VPS, replace this with the GHCR image, e.g.
# HISTRA_SERVER_IMAGE=ghcr.io/mbonatte/histra-job-server:latest
HISTRA_SERVER_IMAGE=histra-job-server:local

# Integrated dashboard
DASHBOARD_ENABLED=true
DASHBOARD_WORKER_ONLINE_SECONDS=300
